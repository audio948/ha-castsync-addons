#!/usr/bin/with-contenv bashio
# Renders the [stream] sections onto upstream's sample snapserver.conf and
# starts the server. Everything except [stream] is left at upstream's
# maintained defaults -- see Dockerfile for why.

set -o pipefail

CONF=/data/snapserver.conf
FRIENDLY_NAME="$(bashio::config 'friendly_name')"

bashio::log.info "Preparing snapserver.conf"
cp /etc/snapserver.conf.sample "${CONF}"

{
    echo ""
    echo "# --- generated by castsync_receiver, appended on every start ---"

    if bashio::config.true 'enable_airplay'; then
        AIRPLAY_PW=""
        if bashio::config.has_value 'airplay_password'; then
            AIRPLAY_PW="&password=$(bashio::config 'airplay_password')"
        fi
        echo ""
        echo "[stream]"
        echo "source = airplay:///shairport-sync?name=AirPlay&devicename=${FRIENDLY_NAME}&port=5000${AIRPLAY_PW}"
    fi

    if bashio::config.true 'enable_spotify'; then
        echo ""
        echo "[stream]"
        echo "source = librespot:///librespot?name=Spotify&devicename=${FRIENDLY_NAME}&bitrate=320&volume=100&autoplay=false&killall=true"
    fi

} >> "${CONF}"

if ! bashio::config.true 'enable_airplay' && ! bashio::config.true 'enable_spotify'; then
    bashio::log.warning "All receivers are disabled -- snapserver will start with no [stream] sources."
fi

LOG_LEVEL="$(bashio::config 'log_level')"
bashio::log.info "Starting snapserver (${FRIENDLY_NAME}), log level ${LOG_LEVEL}"

exec snapserver -c "${CONF}" --logging.sink=stdout
